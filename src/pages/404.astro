---
import Base from '../layouts/Base.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<Base title="Not found" description="Page not found.">
  <section class="shell nf">
    <p class="eyebrow">Error 404 · subcritical</p>
    <h1>This page fired into the void.</h1>
    <p class="nf-text">
      The link you followed doesn't lead anywhere — activity died out before it
      reached a real page. Let's get you back to a stable state.
    </p>
    <p class="nf-links mono">
      <a href={base + '/'}>Home</a>
      <a href={base + '/projects'}>Projects</a>
      <a href={base + '/coursework'}>Coursework</a>
      <a href={base + '/blog'}>Blog</a>
    </p>
  </section>
</Base>

<style>
  .nf { max-width: 34rem; padding-top: 3rem; }
  .nf h1 { margin: 0.3em 0 0.5em; }
  .nf-text { color: var(--ink-soft); font-size: 1.1rem; }
  .nf-links { display: flex; flex-wrap: wrap; gap: 1.25rem; margin-top: 1.5rem; font-size: 0.9rem; }
</style>
