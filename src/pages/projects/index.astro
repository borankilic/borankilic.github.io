---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const projects = (await getCollection('projects')).sort(
  (a, b) => a.data.order - b.data.order,
);
---

<Base wide title="Projects" description="Research and engineering projects by Boran Kılıç — molecular communication, brain criticality, quantum sensing, signal and image processing.">
  <header class="page-head shell-wide">
    <p class="eyebrow">Projects &amp; Research</p>
    <h1>Things I've built and studied</h1>
    <p class="page-intro">
      A mix of research and course projects, mostly sitting where physics, signal
      processing, and complex systems meet. Click any one for the full write-up,
      figures, and materials.
    </p>
  </header>

  <section class="shell-wide">
    <ul class="grid">
      {projects.map((p) => (
        <li>
          <a class="card" href={`${base}/projects/${p.id}`}>
            <div class="card-media">
              <Image
                src={p.data.thumb}
                alt={p.data.thumbAlt}
                widths={[400, 700]}
                sizes="(max-width: 40rem) 92vw, 28rem"
              />
            </div>
            <div class="card-body">
              <div class="card-meta mono">
                <span>{p.data.year}</span>
                {p.data.featured && <span class="tag-featured">Research</span>}
              </div>
              <h2>{p.data.title}</h2>
              <p>{p.data.blurb}</p>
            </div>
          </a>
        </li>
      ))}
    </ul>
  </section>
</Base>

<style>
  .page-head { margin-bottom: 2.5rem; }
  .page-head h1 { margin: 0.15em 0 0.4em; }
  .page-intro { max-width: 38rem; color: var(--ink-soft); font-size: 1.1rem; }

  .grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: clamp(1.5rem, 3vw, 2.5rem);
  }
  .card {
    display: flex;
    flex-direction: column;
    height: 100%;
    color: var(--ink);
    border: 1px solid var(--faint);
    border-radius: 6px;
    overflow: hidden;
    background: #fff;
    transition: border-color 0.18s ease, transform 0.18s ease, box-shadow 0.18s ease;
  }
  .card:hover {
    text-decoration: none;
    border-color: var(--accent);
    transform: translateY(-3px);
    box-shadow: 0 14px 34px rgba(30, 28, 24, 0.1);
  }
  .card-media {
    aspect-ratio: 3 / 2;
    overflow: hidden;
    background: var(--paper-raised);
    border-bottom: 1px solid var(--faint);
  }
  .card-media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.4s ease;
  }
  .card:hover .card-media :global(img) { transform: scale(1.03); }
  .card-body { padding: 1.1rem 1.25rem 1.4rem; display: flex; flex-direction: column; gap: 0.35rem; }
  .card-meta {
    display: flex;
    justify-content: space-between;
    font-size: 0.74rem;
    color: var(--muted);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .tag-featured { color: var(--accent); }
  .card-body h2 {
    font-size: var(--step-1);
    font-weight: 460;
    line-height: 1.18;
    margin: 0.1rem 0 0.15rem;
  }
  .card:hover .card-body h2 { color: var(--accent-deep); }
  .card-body p { margin: 0; color: var(--ink-soft); font-size: 1rem; line-height: 1.5; }

  @media (max-width: 40rem) {
    .grid { grid-template-columns: 1fr; }
  }
</style>
