---
/*
 * Schematic of Boran's phase interferometer, redrawn from his own sketch.
 * Top panel: detection — light from the SiV cavity interferes on a fibre
 * beam splitter and is read out on two APDs, with a free-space delay-stage
 * reference arm. Bottom panel: laser preparation — lock and probe lasers,
 * each gated by an AOM, combined and re-split toward the cavity and the
 * delay stage.
 */
---

<figure class="interf">
  <svg viewBox="0 0 840 660" role="img" aria-label="Schematic of the phase interferometer: SiV detection with two APDs and a free-space delay stage, fed by lock and probe lasers gated through four acousto-optic modulators.">
    <!-- ===== TOP PANEL: detection ===== -->
    <rect class="panel" x="20" y="24" width="800" height="286" rx="10" />
    <text class="panel-tag" x="40" y="50">detection</text>

    <!-- from SiV -> BS1 -->
    <text class="lbl" x="40" y="126">from SiV</text>
    <line class="fibre" x1="120" y1="120" x2="470" y2="120" />
    <circle class="pol" cx="230" cy="120" r="6" /><circle class="pol" cx="250" cy="120" r="6" /><circle class="pol" cx="270" cy="120" r="6" />

    <!-- BS1 -->
    <rect class="bs" x="470" y="104" width="32" height="32" rx="3" transform="rotate(45 486 120)" />
    <text class="cmp" x="486" y="98" text-anchor="middle">BS</text>

    <!-- BS1 -> APD1 / APD2 -->
    <line class="fibre" x1="502" y1="112" x2="700" y2="80" />
    <line class="fibre" x1="502" y1="128" x2="700" y2="160" />
    <rect class="box" x="700" y="64" width="70" height="32" rx="3" /><text class="cmp" x="735" y="84" text-anchor="middle">APD1</text>
    <rect class="box" x="700" y="144" width="70" height="32" rx="3" /><text class="cmp" x="735" y="164" text-anchor="middle">APD2</text>

    <!-- reference arm: BS1 down to collimator, free-space to delay stage -->
    <line class="fibre" x1="486" y1="136" x2="486" y2="210" />
    <path class="coll" d="M470 210 l32 0 l-16 18 z" />
    <line class="beam" x1="486" y1="228" x2="486" y2="258" />
    <line class="beam" x1="486" y1="258" x2="300" y2="258" />
    <!-- delay stage -->
    <rect class="stage" x="150" y="234" width="150" height="52" rx="4" />
    <path class="beam" d="M300 250 l-120 0 M180 250 l14 -8 M180 250 l14 8" />
    <path class="beam" d="M300 266 l-120 0 M180 266 l14 -8 M180 266 l14 8" />
    <line class="rail" x1="150" y1="230" x2="300" y2="230" /><line class="rail" x1="150" y1="290" x2="300" y2="290" />
    <text class="cmp" x="225" y="304" text-anchor="middle">delay stage</text>

    <!-- ===== BOTTOM PANEL: laser preparation ===== -->
    <rect class="panel" x="20" y="352" width="800" height="286" rx="10" />
    <text class="panel-tag" x="40" y="378">laser preparation</text>

    <!-- lasers on the right -->
    <text class="laser" x="800" y="452" text-anchor="end">lock laser</text>
    <text class="laser" x="800" y="566" text-anchor="end">probe laser</text>

    <!-- lock -> AOM3 -> BS2 (top branch) -->
    <line class="fibre" x1="690" y1="446" x2="712" y2="446" />
    <rect class="box" x="622" y="430" width="68" height="32" rx="3" /><text class="cmp" x="656" y="450" text-anchor="middle">AOM3</text>
    <line class="fibre" x1="440" y1="446" x2="622" y2="446" />
    <circle class="pol" cx="540" cy="446" r="6" /><circle class="pol" cx="560" cy="446" r="6" />

    <!-- probe -> AOM4 -> BS2 (bottom branch) -->
    <line class="fibre" x1="690" y1="560" x2="712" y2="560" />
    <rect class="box" x="622" y="544" width="68" height="32" rx="3" /><text class="cmp" x="656" y="564" text-anchor="middle">AOM4</text>
    <line class="fibre" x1="440" y1="560" x2="622" y2="560" />
    <circle class="pol" cx="540" cy="560" r="6" /><circle class="pol" cx="560" cy="560" r="6" />

    <!-- BS2 -->
    <line class="fibre" x1="420" y1="446" x2="420" y2="560" />
    <rect class="bs" x="404" y="487" width="32" height="32" rx="3" transform="rotate(45 420 503)" />
    <text class="cmp" x="420" y="481" text-anchor="middle">BS</text>

    <!-- BS2 -> AOM1 -> to SiV (top) -->
    <line class="fibre" x1="404" y1="495" x2="318" y2="446" />
    <rect class="box" x="250" y="430" width="68" height="32" rx="3" /><text class="cmp" x="284" y="450" text-anchor="middle">AOM1</text>
    <line class="fibre" x1="130" y1="446" x2="250" y2="446" />
    <circle class="pol" cx="180" cy="446" r="6" /><circle class="pol" cx="200" cy="446" r="6" />
    <text class="lbl" x="40" y="452">to SiV</text>

    <!-- BS2 -> AOM2 -> to delay stage (bottom) -->
    <line class="fibre" x1="404" y1="511" x2="318" y2="560" />
    <rect class="box" x="250" y="544" width="68" height="32" rx="3" /><text class="cmp" x="284" y="564" text-anchor="middle">AOM2</text>
    <line class="fibre" x1="130" y1="560" x2="250" y2="560" />
    <circle class="pol" cx="180" cy="560" r="6" /><circle class="pol" cx="200" cy="560" r="6" />
    <text class="lbl" x="40" y="566">to delay</text>
  </svg>
</figure>

<style>
  .interf { margin: 0; }
  .interf svg { display: block; width: 100%; height: auto; }
  .panel { fill: #fff; stroke: var(--faint); stroke-width: 1.5; }
  .panel-tag {
    font-family: var(--font-mono); font-size: 13px; letter-spacing: 0.12em;
    text-transform: uppercase; fill: var(--muted);
  }
  .fibre { stroke: var(--ink); stroke-width: 2; fill: none; stroke-linecap: round; }
  .beam { stroke: #c0392b; stroke-width: 2; fill: none; stroke-linecap: round; stroke-linejoin: round; }
  .rail { stroke: var(--muted); stroke-width: 1.5; stroke-dasharray: 2 4; }
  .box { fill: var(--paper-raised); stroke: var(--ink); stroke-width: 1.5; }
  .bs { fill: var(--accent-wash); stroke: var(--accent); stroke-width: 1.6; }
  .stage { fill: none; stroke: var(--muted); stroke-width: 1.2; stroke-dasharray: 4 4; }
  .coll { fill: var(--ink); }
  .pol { fill: none; stroke: var(--ink); stroke-width: 1.4; }
  .cmp { font-family: var(--font-mono); font-size: 13px; fill: var(--ink); }
  .lbl { font-family: var(--font-body); font-size: 15px; font-style: italic; fill: var(--ink-soft); }
  .laser { font-family: var(--font-body); font-size: 15px; font-style: italic; fill: #c0392b; }
</style>
