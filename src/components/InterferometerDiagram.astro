---
/*
 * Schematic of Boran's phase interferometer, redrawn from his own sketch
 * (g12Inter_exp_setup.pdf). Top panel: "G12 experiment table" — a fibre
 * Mach-Zehnder. Probe+phaselocking light is split into a signal arm
 * (POL -> in-fibre AOM -> 99:1 tap -> protection tube -> circulator ->
 * double-pass free-space AOM -> 99:1 -> SiV nanophotonic cavity) and a
 * reference arm (POL -> in-fibre AOM -> adjustable attenuator -> ~46 m
 * fibre spool). The 99:1 tap and the reference arm recombine on a 50:50
 * fibre coupler read out on APD1/APD2; their outputs drive a servo
 * (dashed accent lines, "δφ_AOM") that phase-locks the two
 * in-fibre AOMs. Bottom panel: laser preparation — a Toptica (cavity
 * probe) and a TiSa (lock) laser, each gated by an AOM, are combined and
 * sent through a PM adjustable attenuator up to the top panel's input.
 */
---

<figure class="interf">
  <svg viewBox="0 0 840 1100" role="img" aria-label="Schematic of the phase interferometer: a fibre Mach-Zehnder on the G12 experiment table splits probe and phase-locking light into a signal arm (in-fibre AOM, 99:1 tap, protection tube, circulator, double-pass free-space AOM) toward an SiV nanophotonic cavity, and a reference arm (in-fibre AOM, adjustable attenuator, 46 metre fibre spool); the recombined light is read on two APDs whose signal drives a servo that phase-locks the two AOMs. A lower panel shows the laser preparation stage combining a Toptica cavity-probe laser and a TiSa lock laser before the input.">

    <!-- ============ TOP PANEL: G12 experiment table ============ -->
    <rect class="panel" x="20" y="20" width="800" height="660" rx="10" />
    <text class="panel-tag" x="40" y="46">G12 experiment table</text>

    <!-- phase-lock servo -->
    <circle class="servo" cx="100" cy="90" r="16" />
    <path class="servo-wave" d="M87,90 Q93.5,79 100,90 T113,90" />
    <text class="fblbl" x="100" y="64" text-anchor="middle">&#948;&#966;_AOM</text>

    <!-- feedback: APD1/APD2 -> servo -->
    <path class="fb" d="M300,240 L70,240 L70,90 L84,90" />
    <path class="fb" d="M300,350 L58,350 L58,90 L84,90" />
    <!-- feedback: servo -> reference-arm AOM -->
    <path class="fb" d="M100,106 L100,130 L86,130 L86,435 L128,435" />
    <!-- feedback: servo -> signal-arm AOM -->
    <path class="fb" d="M116,90 L116,55 L805,55 L805,435 L492,435" />

    <!-- input: Probe + Phaselocking, fibre splitter BS_in -->
    <line class="fibre" x1="310" y1="624.8" x2="310" y2="760" />
    <rect class="bs" x="296" y="591" width="28" height="28" rx="2" transform="rotate(45 310 605)" />
    <text class="cmp" x="322" y="648">BS</text>
    <line class="fibre" x1="290.2" y1="605" x2="150" y2="560" />
    <line class="fibre" x1="329.8" y1="605" x2="470" y2="560" />

    <!-- ===== reference arm (x = 150) ===== -->
    <line class="fibre" x1="150" y1="560" x2="150" y2="525" />
    <circle class="pol" cx="150" cy="520" r="5" /><circle class="pol" cx="150" cy="505" r="5" /><circle class="pol" cx="150" cy="490" r="5" />
    <line class="fibre" x1="150" y1="485" x2="150" y2="452" />
    <rect class="box" x="128" y="418" width="44" height="34" rx="3" />
    <text class="cmp" x="150" y="410" text-anchor="middle">AOM</text>
    <line class="fibre" x1="150" y1="418" x2="150" y2="380" />
    <rect class="box atten" x="136" y="360" width="28" height="20" rx="2" />
    <line class="slash" x1="136" y1="380" x2="164" y2="360" />
    <text class="cmp" x="172" y="374">atten.</text>
    <line class="fibre" x1="150" y1="360" x2="150" y2="346" />
    <!-- ~46 m fibre spool -->
    <circle class="spool" cx="150" cy="320" r="10" /><circle class="spool" cx="150" cy="320" r="17" /><circle class="spool" cx="150" cy="320" r="24" />
    <text class="cmp" x="107" y="320" text-anchor="middle" transform="rotate(-90 107 320)">~46 m fibre spool</text>
    <line class="fibre" x1="150" y1="296" x2="250.2" y2="300" />

    <!-- recombination 50:50 coupler -->
    <rect class="bs" x="256" y="286" width="28" height="28" rx="2" transform="rotate(45 270 300)" />
    <text class="cmp" x="230" y="278" text-anchor="end">50:50</text>
    <line class="fibre" x1="289.8" y1="300" x2="300" y2="240" />
    <line class="fibre" x1="289.8" y1="300" x2="300" y2="350" />

    <!-- APDs -->
    <rect class="box" x="300" y="225" width="64" height="30" rx="3" />
    <text class="cmp" x="332" y="244" text-anchor="middle">APD1</text>
    <rect class="box" x="300" y="335" width="64" height="30" rx="3" />
    <text class="cmp" x="332" y="354" text-anchor="middle">APD2</text>

    <!-- ===== signal arm (x = 470) ===== -->
    <line class="fibre" x1="470" y1="560" x2="470" y2="525" />
    <circle class="pol" cx="470" cy="520" r="5" /><circle class="pol" cx="470" cy="505" r="5" /><circle class="pol" cx="470" cy="490" r="5" />
    <line class="fibre" x1="470" y1="485" x2="470" y2="452" />
    <rect class="box" x="448" y="418" width="44" height="34" rx="3" />
    <text class="cmp" x="470" y="466" text-anchor="middle">AOM</text>
    <line class="fibre" x1="470" y1="418" x2="470" y2="407.56" />

    <!-- first 99:1 tap: 1% continues to recombination BS, main path up -->
    <rect class="bs" x="459" y="381" width="22" height="22" rx="2" transform="rotate(45 470 392)" />
    <text class="cmp" x="492" y="396">99:1</text>
    <path class="fibre" d="M454.44,392 L430,392 L430,462 L270,462 L270,319.8" />
    <line class="fibre" x1="470" y1="376.44" x2="470" y2="372" />

    <!-- protection tube -->
    <rect class="tube" x="456" y="300" width="28" height="72" rx="2" />
    <line class="hatch" x1="456" y1="314" x2="484" y2="308" />
    <line class="hatch" x1="456" y1="330" x2="484" y2="324" />
    <line class="hatch" x1="456" y1="346" x2="484" y2="340" />
    <line class="hatch" x1="456" y1="362" x2="484" y2="356" />
    <text class="cmp" x="498" y="338">Protection Tube</text>
    <line class="fibre" x1="470" y1="300" x2="470" y2="279" />

    <!-- circulator -->
    <circle class="circ" cx="470" cy="265" r="14" />
    <path class="circ-arrow" d="M463,257 A9,9 0 1 1 463,273" />
    <text class="cmp" x="492" y="252">circulator</text>

    <!-- double-pass free-space AOM with 0th-order dump -->
    <line class="beam" x1="470" y1="251" x2="470" y2="208" />
    <rect class="box fsbox" x="448" y="176" width="44" height="32" rx="3" />
    <text class="cmp" x="470" y="168" text-anchor="middle">AOM</text>
    <path class="beam" d="M470,176 L470,145 L410,145" />
    <path class="dump" d="M404,138 L416,152" />
    <text class="beamlbl" x="398" y="133" text-anchor="end">0th</text>

    <!-- circulator -> second 99:1 -> SiV cavity -->
    <line class="fibre" x1="484" y1="265" x2="579.44" y2="265" />
    <rect class="bs" x="584" y="254" width="22" height="22" rx="2" transform="rotate(45 595 265)" />
    <text class="cmp" x="595" y="245" text-anchor="middle">99:1</text>
    <line class="fibre" x1="610.56" y1="265" x2="640" y2="265" />
    <rect class="box" x="640" y="240" width="160" height="50" rx="4" />
    <text class="cmp" x="720" y="260" text-anchor="middle">SiV</text>
    <text class="cmp" x="720" y="276" text-anchor="middle">nanophotonic cavity</text>

    <!-- ============ BOTTOM PANEL: laser preparation ============ -->
    <rect class="panel" x="20" y="740" width="800" height="320" rx="10" />
    <text class="panel-tag" x="40" y="766">laser preparation</text>

    <!-- Toptica (cav probe) -->
    <text class="laser" x="60" y="834">Toptica (cav probe)</text>
    <line class="fibre" x1="200" y1="830" x2="266" y2="830" />
    <rect class="bs" x="266" y="816" width="28" height="28" rx="2" transform="rotate(45 280 830)" />
    <line class="fibre faded" x1="280" y1="849.8" x2="280" y2="888" />
    <text class="lbl faded" x="285" y="900">other things&#8230;</text>
    <circle class="pol" cx="325" cy="830" r="5" /><circle class="pol" cx="340" cy="830" r="5" /><circle class="pol" cx="355" cy="830" r="5" />
    <line class="fibre" x1="299.8" y1="830" x2="318" y2="830" />
    <line class="fibre" x1="362" y1="830" x2="380" y2="830" />
    <rect class="box" x="380" y="814" width="44" height="32" rx="3" />
    <text class="cmp" x="402" y="808" text-anchor="middle">AOM</text>
    <line class="fibre" x1="424" y1="830" x2="470" y2="870.2" />

    <!-- TiSa (lock) -->
    <text class="laser" x="60" y="954">TiSa (lock)</text>
    <line class="fibre" x1="200" y1="950" x2="380" y2="950" />
    <rect class="box" x="380" y="934" width="44" height="32" rx="3" />
    <text class="cmp" x="402" y="928" text-anchor="middle">AOM</text>
    <line class="fibre" x1="424" y1="950" x2="470" y2="909.8" />

    <!-- combiner -->
    <rect class="bs" x="456" y="876" width="28" height="28" rx="2" transform="rotate(45 470 890)" />
    <line class="fibre" x1="489.8" y1="890" x2="510" y2="890" />
    <circle class="pol" cx="525" cy="890" r="5" /><circle class="pol" cx="540" cy="890" r="5" /><circle class="pol" cx="555" cy="890" r="5" />
    <line class="fibre" x1="560" y1="890" x2="580" y2="890" />

    <!-- PM adjustable attenuator -->
    <rect class="box atten" x="580" y="874" width="50" height="32" rx="3" />
    <line class="slash" x1="580" y1="906" x2="630" y2="874" />
    <text class="cmp" x="605" y="856" text-anchor="middle">PM adjustable</text>
    <text class="cmp" x="605" y="868" text-anchor="middle">attenuator</text>

    <!-- up to G12 table input -->
    <path class="fibre" d="M630,890 L630,760 L310,760" />
    <text class="lbl" x="325" y="712">Probe + Phaselocking</text>
  </svg>
</figure>

<style>
  .interf { margin: 0; }
  .interf svg { display: block; width: 100%; height: auto; }
  .panel { fill: #fff; stroke: var(--faint); stroke-width: 1.5; }
  .panel-tag {
    font-family: var(--font-mono); font-size: 13px; letter-spacing: 0.12em;
    text-transform: uppercase; fill: var(--muted);
  }
  .fibre { stroke: var(--ink); stroke-width: 2; fill: none; stroke-linecap: round; stroke-linejoin: round; }
  .fibre.faded { opacity: 0.5; }
  .beam { stroke: #c0392b; stroke-width: 2; fill: none; stroke-linecap: round; stroke-linejoin: round; }
  .box { fill: var(--paper-raised); stroke: var(--ink); stroke-width: 1.5; }
  .fsbox { stroke: #c0392b; }
  .bs { fill: var(--accent-wash); stroke: var(--accent); stroke-width: 1.6; }
  .pol { fill: none; stroke: var(--ink); stroke-width: 1.4; }
  .spool { fill: none; stroke: var(--muted); stroke-width: 1.2; }
  .atten { fill: var(--paper-raised); }
  .slash { stroke: var(--ink); stroke-width: 1.4; }
  .tube { fill: var(--accent-wash); stroke: var(--ink); stroke-width: 1.5; }
  .hatch { stroke: var(--accent-deep); stroke-width: 1; opacity: 0.6; }
  .circ { fill: none; stroke: var(--ink); stroke-width: 1.6; }
  .circ-arrow { fill: none; stroke: var(--ink); stroke-width: 1.4; }
  .dump { stroke: #c0392b; stroke-width: 2; }
  .servo { fill: var(--accent-wash); stroke: var(--accent); stroke-width: 1.6; }
  .servo-wave { fill: none; stroke: var(--accent); stroke-width: 1.6; }
  .fb { fill: none; stroke: var(--accent); stroke-width: 1.6; stroke-dasharray: 5 4; }
  .cmp { font-family: var(--font-mono); font-size: 13px; fill: var(--ink); }
  .beamlbl { font-family: var(--font-mono); font-size: 13px; fill: #c0392b; }
  .fblbl { font-family: var(--font-mono); font-size: 13px; fill: var(--accent-deep); }
  .lbl { font-family: var(--font-body); font-size: 15px; font-style: italic; fill: var(--ink-soft); }
  .lbl.faded { opacity: 0.55; }
  .laser { font-family: var(--font-body); font-size: 15px; font-style: italic; fill: #c0392b; }
</style>
