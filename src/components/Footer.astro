---
const year = new Date().getFullYear();
---

<footer class="site-foot">
  <div class="shell-wide foot-inner">
    <p class="foot-name">Boran&nbsp;Kılıç<span class="dot">.</span></p>
    <p class="foot-meta">
      Built with <a href="https://astro.build" target="_blank" rel="noopener">Astro</a>,
      hosted on GitHub&nbsp;Pages. © {year}.
    </p>
    <p class="foot-links">
      <a href="https://github.com/borankilic" target="_blank" rel="me noopener">GitHub</a>
      <a href="https://www.linkedin.com/in/bkilic7/" target="_blank" rel="me noopener">LinkedIn</a>
      <a href="https://scholar.google.com/citations?user=9SPQHJEAAAAJ&hl=en" target="_blank" rel="me noopener">Scholar</a>
    </p>
  </div>
</footer>

<style>
  .site-foot {
    border-top: 1px solid var(--faint);
    margin-top: 5rem;
    padding: 2.5rem 0 3.5rem;
  }
  .foot-inner {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.6rem 2rem;
  }
  .foot-name {
    font-family: var(--font-display);
    font-size: 1.1rem;
    margin: 0;
  }
  .dot { color: var(--accent); }
  .foot-meta {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.74rem;
    color: var(--muted);
    letter-spacing: 0.01em;
  }
  .foot-links {
    display: flex;
    gap: 1.1rem;
    margin: 0;
  }
  .foot-links a {
    font-family: var(--font-mono);
    font-size: 0.74rem;
    color: var(--muted);
  }
  .foot-links a:hover { color: var(--accent); text-decoration: none; }
</style>
