# macOS
.DS_Store

# Node / Astro (once scaffolded)
node_modules/
dist/
.astro/

# This project lives under an iCloud-synced ~/Desktop. iCloud evicts file
# contents inside node_modules (dataless placeholders), which breaks builds
# with ETIMEDOUT on read. macOS skips any path ending in .nosync, so deps are
# installed into node_modules.nosync with node_modules symlinked to it.
node_modules.nosync/

# Foreman orchestration scratch
.foreman/

# Editor
.vscode/
.idea/

# Env
.env
.env.*

# Staging area: raw source materials (originals kept on disk, processed copies
# live in public/ and src/assets/). Keeps the repo lean and under Pages limits.
uploads/
